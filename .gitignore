__pycache__/
*.py[cod]
.ruff_cache/
.vscode/
.ipynb_checkpoints/
.agents/
.codex/
.aws/

# Local observations, checkpoints and full execution records are not source.
/experiments/**/results/
/experiments/**/runs/
/artifacts/local/
*.npz
*.npy
*.pt
*.pth
*.pkl
*.pickle

# Explicitly curated, compact scientific evidence.
!artifacts/benchmark_2026-11-07/**/*.npz
!archive/experiments/**/*.summary.npz
!archive/reports/**/*.npz

# Regenerable LaTeX build artifacts; manuscript PDFs remain versioned.
*.aux
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.xdv
